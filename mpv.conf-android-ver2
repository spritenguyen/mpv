# Kích hoạt script autoload cho phụ đề tự động
script=/storage/emulated/0/Android/media/is.xyz.mpv/scripts/autoload.lua
script=/storage/emulated/0/Android/media/is.xyz.mpv/scripts/auto-reload.lua
script=/storage/emulated/0/Android/media/is.xyz.mpv/scripts/hdr-config.lua

# Tùy chọn dành cho youtube-dl (hoặc yt-dlp) để tải nhanh
ytdl-raw-options=external-downloader-args=["-x", "16", "-s", "16", "-k", "1M"]

keep-open=yes  # Giữ cửa sổ MPV sau khi video kết thúc

# Tùy chỉnh phụ đề
sub-font-size=64  # Giảm kích thước font để giảm tải GPU
#sub-font="Droid Sans"  # Hoặc bất kỳ font nào bạn đã cài đặt
sub-color="#FFFFFF"  # Màu chữ trắng
sub-shadow-color="#000000"  # Màu viền đen để tăng độ rõ ràng
sub-shadow-offset=2
sub-border-size=2

# Cấu hình cache cho phát trực tuyến
cache=yes
cache-secs=90  # Giảm thời gian cache để tiết kiệm tài nguyên
demuxer-max-bytes=512MiB  # Giảm dung lượng cache
demuxer-max-back-bytes=50MiB

ytdl-raw-options-append=extractor-args=youtube:player_skip=js  # Tăng tốc mở video
script-opts=ytdl_hook-try_ytdl_first=yes,ytdl_hook-exclude="%.webm$|%.ts$|%.mp3$|%.m3u8$|%.m3u$|%.mkv$|%.mp4$|%.VOB$|%.wmv$|%.ogg$|%.mpd$|%.mov$|%.webm$|%.webp$|%.avi$|%.flv$|%.swf$|%.f4v$"

# Renderer GPU với Vulkan API để tận dụng Snapdragon 778G
gpu-api=vulkan
vo=gpu-next

# Giải mã phần cứng
hwdec=mediacodec
hwdec-interop=auto

##################################################################################
# Xử lý HDR tối ưu cho HDR10+
tone-mapping=hable
hdr-compute-peak=yes
gamut-clipping=no  # Vô hiệu hóa clipping để giảm tải GPU
target-prim=bt2020
target-contrast=0.9
hdr-contrast-recovery=0.8  # Giảm nhẹ để tối ưu hiệu suất

# Tùy chỉnh scaling để cân bằng hiệu suất và chất lượng
scale=ewa_lanczos
scale-antiring=0.5  # Giảm nhẹ antiring để giảm tải GPU
dscale=bilinear  # Downscale đơn giản để giảm tải
tscale=linear  # Nội suy đơn giản cho video FPS thấp

# Giới hạn tài nguyên để duy trì nhiệt độ ổn định và giảm tải
swapchain-depth=2  # Giảm độ sâu swapchain để hạ nhiệt độ
gpu-max-frames=2  # Giới hạn khung hình GPU xử lý

# Xử lý video với FPS thấp để phát mượt mà hơn
interpolation=no  # Tắt nội suy để giảm tải GPU nếu không cần thiết

# Bật dithering (nếu cần) để cải thiện màu sắc
temporal-dither=no
dither-depth=6  # Giảm độ sâu dithering để tiết kiệm GPU

# Tối ưu âm thanh
audio-samplerate=48000  # Giảm tần số âm thanh để tiết kiệm tài nguyên
audio-channels=stereo
audio-normalize-downmix=yes
audio-output-channels=2
volume-max=100
volume=80
