# Tắt thanh trạng thái và viền cửa sổ
osd-bar=no
border=no
geometry=36%

# Tắt màn hình sau 60 giây khi không hoạt động
idle-timeout=60

# Sử dụng GPU để xử lý video
vo=gpu-next
gpu-api=opengl  # GPU tích hợp Radeon Vega hoạt động tốt hơn với OpenGL
hwdec=auto
hwdec-interop=auto
keep-open=yes  # Giữ cửa sổ MPV sau khi video kết thúc

# Tăng cường chất lượng âm thanh
audio-samplerate=96000
audio-channels=stereo
audio-normalize-downmix=yes
audio-buffer=0.3
volume-max=100
volume=80

# Tăng cường hiệu suất và bộ nhớ cache
cache=yes
cache-secs=600
demuxer-readahead-secs=60
demuxer-max-bytes=2GiB  # Tối ưu dung lượng cache
demuxer-max-back-bytes=200MiB
network-timeout=60

# Tăng tốc xử lý khi sử dụng yt-dlp/youtube-dl
ytdl-format=(bv*[vcodec~='^((he|a)vc|h26[45])'][protocol!*=m3u8]+ba)/(bv*+ba/b)  # Ưu tiên H264
ytdl-raw-options-append=extractor-args=youtube:player_skip=js  # Tăng tốc mở video
script-opts=ytdl_hook-try_ytdl_first=yes,ytdl_hook-exclude="%.webm$|%.ts$|%.mp3$|%.m3u8$|%.m3u$|%.mkv$|%.mp4$|%.VOB$|%.wmv$|%.ogg$|%.mpd$|%.mov$|%.webm$|%.webp$|%.avi$|%.flv$|%.swf$|%.f4v$"

# Tự động chọn track audio/subtitle theo ngôn ngữ
track-auto-selection=yes
alang=ja,jp,jpn,vi,vie,en,eng  # Thứ tự ưu tiên audio
slang=vi,vie  # Thứ tự ưu tiên phụ đề
ytdl-raw-options=write-thumbnail=,sub-lang="vi,vi-vi,en,en-en",yes-playlist=  # Tải danh sách sub

# Tùy chỉnh phụ đề
#sub-font="Droid Sans"  # Bạn có thể thay đổi nếu muốn
sub-font-size=68
sub-color="#FFFFFF"
sub-shadow-color="#000000"
sub-shadow-offset=2
sub-border-size=2
#sub-pos=50

# Tăng hiệu suất xử lý video
gpu-max-frames=2
swapchain-depth=2
scale=ewa_lanczos
scale-antiring=0.8
dscale=mitchell
tscale=catmull_rom  # Chuyển động mượt mà hơn cho video FPS thấp

# Tùy chỉnh xử lý HDR
tone-mapping=hable
hdr-compute-peak=yes
gamut-clipping=yes
target-prim=bt2020
target-contrast=1.0
hdr-contrast-recovery=0.85

# Dithering (cải thiện hiển thị màu sắc)
temporal-dither=no
dither-depth=8
